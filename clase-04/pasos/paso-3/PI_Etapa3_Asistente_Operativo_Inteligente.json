    {
      "parameters": {
        "jsCode": "return [\n  {\n    json: {\n      id: 1,\n      titulo: \"Presentar declaración mensual de Panadería Don Julio\",\n      responsable: \"Tomás\",\n      estado: \"pendiente\",\n      prioridad: \"alta\",\n      fecha_vencimiento: \"2026-11-16\",\n      comentario: \"Julio llamó dos veces: si no presentamos la declaración hoy le cobran un recargo, y está muy molesto.\"\n    }\n  },\n  {\n    json: {\n      id: 2,\n      titulo: \"Liquidar sueldos de noviembre de Ferretería Norte\",\n      responsable: \"Tomás\",\n      estado: \"en_proceso\",\n      prioridad: \"alta\",\n      fecha_vencimiento: \"2026-11-30\",\n      comentario: \"Falta la planilla de horas extra; el cliente dijo que la manda esta semana.\"\n    }\n  },\n  {\n    json: {\n      id: 3,\n      titulo: \"Confirmar reunión de diagnóstico con Café Molino\",\n      responsable: \"Valeria\",\n      estado: \"pendiente\",\n      prioridad: \"media\",\n      fecha_vencimiento: \"2026-11-12\",\n      comentario: \"La dueña pidió confirmar la reunión por mensaje y todavía no le respondimos.\"\n    }\n  },\n  {\n    json: {\n      id: 4,\n      titulo: \"Archivar comprobantes de octubre\",\n      responsable: \"Tomás\",\n      estado: \"completada\",\n      prioridad: \"baja\",\n      fecha_vencimiento: \"2026-11-10\",\n      comentario: \"Quedó todo archivado, sin novedades.\"\n    }\n  },\n  {\n    json: {\n      id: 5,\n      titulo: \"\",\n      responsable: \"Carolina\",\n      estado: \"pendiente\",\n      prioridad: \"baja\",\n      fecha_vencimiento: \"2026-11-20\",\n      comentario: \"Revisar.\"\n    }\n  },\n  {\n    json: {\n      id: 6,\n      titulo: \"Preparar propuesta para Taller Mecánico Ruta 3\",\n      responsable: \"Valeria\",\n      estado: \"en_proceso\",\n      prioridad: \"media\",\n      fecha_vencimiento: \"2026-11-18\",\n      comentario: \"El taller está entusiasmado y espera la propuesta hoy para decidir.\"\n    }\n  }\n];"
      },
      "id": "a1f3c2d4-2222-4a5b-9c0d-000000000002",
      "name": "Crear tareas de ejemplo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const tarea = item.json;\n  const errores = [];\n\n  if (!tarea.titulo || tarea.titulo.trim() === \"\") {\n    errores.push(\"Falta el título\");\n  }\n  if (!tarea.responsable || tarea.responsable.trim() === \"\") {\n    errores.push(\"Falta el responsable\");\n  }\n  if (!tarea.estado || tarea.estado.trim() === \"\") {\n    errores.push(\"Falta el estado\");\n  }\n\n  tarea.es_valida = errores.length === 0;\n  tarea.errores = errores;\n  return item;\n});"
      },
      "id": "b2f3c2d4-0003-4a5b-9c0d-000000000003",
      "name": "Validar tareas",
